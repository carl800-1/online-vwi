{
  "name": "online-vwi-terminal",
  "version": "1.7.1",
  "productName": "ESOP-Client",
  "description": "在线 VWI 发布系统 · 工作台接收端（kiosk 全屏播放）",
  "main": "main.js",
  "type": "commonjs",
  "private": true,
  "author": "Frank",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node test/migrate-test.cjs && node test/sync-test.cjs",
    "preview": "node test/serve.cjs",
    "dist": "electron-builder --win portable --x64",
    "dist:dir": "electron-builder --win --dir --x64"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "electronDownload": {
      "isVerifyChecksum": false
    },
    "appId": "com.frank.esop-client",
    "productName": "ESOP-Client",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "assets/**/*",
      "!test/**",
      "!tools/**"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "ESOP-Client.exe",
      "requestExecutionLevel": "user",
      "unpackDirName": "esop-client"
    }
  }
}
