{
  "name": "online-vwi",
  "version": "3.2.0",
  "private": true,
  "description": "ESOP 发布系统 —— 机种 × 线体 × 工位 播放清单，线体总览换型",
  "type": "module",
  "main": "server-gui/main.js",
  "author": "Frank",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node test/run.mjs",
    "gui": "electron .",
    "gui:dev": "electron . --dev",
    "gui:dist": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "mupdf": "^1.28.1"
  },
  "devDependencies": {
    "electron": "40.10.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.frank.esop-server",
    "productName": "ESOP-Server",
    "asar": false,
    "electronDownload": {
      "isVerifyChecksum": false
    },
    "directories": {
      "output": "server-gui/dist",
      "buildResources": "server-gui/assets"
    },
    "files": [
      "package.json",
      "server-gui/main.js",
      "server-gui/preload.cjs",
      "server-gui/assets/**",
      "src/**",
      "public/**",
      "node_modules/mupdf/**",
      "!data/**"
    ],
    "win": {
      "icon": "server-gui/assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "ESOP-Server.exe",
      "requestExecutionLevel": "user",
      "unpackDirName": "esop-server"
    }
  }
}
